generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Shared schema foundation. Feature-specific models will be added together
// so all three team members use the same IDs and relationships.
model User {
  id                 String            @id @default(cuid())
  name               String
  email              String            @unique
  passwordHash       String?
  role               UserRole          @default(SALESPERSON)
  createdAt          DateTime          @default(now())
  customerId         String?           @unique
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotations         Quotation[]
  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  assignedApprovals  ApprovalRequest[] @relation("AssignedApprovals")
  createdNegotiations Negotiation[]     @relation("CreatedNegotiations")
  negotiationEvents  NegotiationEvent[] @relation("NegotiationActors")
}

enum UserRole {
  ADMIN
  SALESPERSON
  MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  NEGOTIATION
  ACCEPTED
  CONVERTED
  CANCELLED
}

model Customer {
  id              String      @id @default(cuid())
  name            String
  email           String?
  phone           String?
  company         String?
  customerTier    String      @default("STANDARD") @map("tier")
  billingAddress  String?
  shippingAddress String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?
  quotations      Quotation[]
  negotiations    Negotiation[]
}

model Product {
  id              String           @id @default(cuid())
  name            String
  sku             String           @unique
  basePrice       Decimal          @map("price") @db.Decimal(12, 2)
  category        String
  description     String?
  productType     ProductType      @default(ONE_TIME)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  quotationItems  QuotationItem[]
  priceListItems  PriceListItem[]
  warehouseStocks WarehouseStock[]
  orderItems      OrderItem[]
  backorders      Backorder[]
}

model PriceList {
  id        String          @id @default(cuid())
  name      String
  currency  String          @default("INR")
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     PriceListItem[]
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  productId   String
  price       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([priceListId, productId])
  @@index([productId])
}

model Quotation {
  id               String            @id @default(cuid())
  quotationNumber  String            @unique
  customerId       String
  salespersonId    String
  status           QuotationStatus   @default(DRAFT)
  subtotal         Decimal           @db.Decimal(14, 2)
  discountPercent  Decimal           @db.Decimal(5, 2)
  discountAmount   Decimal           @db.Decimal(14, 2)
  taxPercent       Decimal           @db.Decimal(5, 2)
  taxAmount        Decimal           @db.Decimal(14, 2)
  total            Decimal           @db.Decimal(14, 2)
  marginAmount     Decimal           @db.Decimal(14, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesperson      User              @relation(fields: [salespersonId], references: [id], onDelete: Restrict)
  items            QuotationItem[]
  approvalRequests ApprovalRequest[]
  order            Order?
  negotiations     Negotiation[]

  @@index([customerId])
  @@index([salespersonId])
  @@index([status])
}

model QuotationItem {
  id              String     @id @default(cuid())
  quotationId     String
  productId       String
  quantity        Decimal    @db.Decimal(12, 2)
  unitPrice       Decimal    @db.Decimal(12, 2)
  discountPercent Decimal    @db.Decimal(5, 2)
  discountAmount  Decimal    @db.Decimal(14, 2)
  lineTotal       Decimal    @db.Decimal(14, 2)
  quotation       Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem       OrderItem?

  @@index([productId])
}

model DiscountRule {
  id                 String   @id @default(cuid())
  customerTier       String
  productCategory    String
  maxDiscountPercent Decimal  @db.Decimal(5, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([customerTier, productCategory])
  @@index([productCategory])
}

model ApprovalRule {
  id                        String   @id @default(cuid())
  name                      String
  minBlendedDiscountPercent Decimal  @db.Decimal(5, 2)
  requiresLineViolation     Boolean  @default(false)
  requiresManager           Boolean  @default(true)
  requiresFinance           Boolean  @default(false)
  active                    Boolean  @default(true)
  priority                  Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([active, priority])
  @@index([minBlendedDiscountPercent])
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  quotationId   String
  requestedById String
  approverId    String?
  approvalRole  ApprovalRole
  reason        String
  status        ApprovalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?
  quotation     Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation("RequestedApprovals", fields: [requestedById], references: [id], onDelete: Restrict)
  approver      User?          @relation("AssignedApprovals", fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([quotationId, approvalRole])
  @@index([quotationId])
  @@index([requestedById])
  @@index([approverId])
  @@index([status])
}

model Negotiation {
  id                            String            @id @default(cuid())
  quotationId                   String
  customerId                    String
  createdBy                     String
  status                        NegotiationStatus @default(OPEN)
  customerRequestedDiscount     Decimal?
  customerRequestedQuantity     Decimal?
  customerRequestedPaymentTerms String?
  customerMessage               String?
  currentDiscount               Decimal
  proposedDiscount              Decimal?
  proposedQuantity              Decimal?
  proposedPaymentTerms          String?
  proposedMessage               String?
  calculatedSubtotal            Decimal?
  calculatedTotal               Decimal?
  calculatedMargin              Decimal?
  approvalRequired              Boolean           @default(false)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  quotation                     Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  customer                      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator                       User              @relation("CreatedNegotiations", fields: [createdBy], references: [id], onDelete: Restrict)
  events                        NegotiationEvent[]

  @@index([quotationId])
  @@index([customerId])
  @@index([createdBy])
  @@index([status])
}

model NegotiationEvent {
  id            String      @id @default(cuid())
  negotiationId String
  actorId       String?
  eventType     String
  message       String?
  createdAt     DateTime    @default(now())
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  actor         User?       @relation("NegotiationActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([negotiationId, createdAt])
  @@index([actorId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  quotationId String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quotation   Quotation   @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  backorders  Backorder[]
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  quotationItemId String  @unique
  productId       String
  quantity        Int
  unitPrice       Decimal @db.Decimal(14, 2)
  lineTotal       Decimal @db.Decimal(14, 2)

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quotationItem QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  allocations   Allocation[]
  backorders    Backorder[]

  @@index([orderId])
  @@index([productId])
}

model Warehouse {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  location    String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  stock       WarehouseStock[]
  allocations Allocation[]
}

model WarehouseStock {
  id                String    @id @default(cuid())
  warehouseId       String
  productId         String
  availableQuantity Decimal   @default(0) @db.Decimal(12, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId])
  @@index([productId])
}

model Allocation {
  id                String       @id @default(cuid())
  orderItemId       String
  warehouseId       String
  allocatedQuantity Decimal      @db.Decimal(12, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  orderItem         OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  warehouse         Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  fulfillment       Fulfillment?

  @@unique([orderItemId, warehouseId])
  @@index([warehouseId])
}

model Fulfillment {
  id                String            @id @default(cuid())
  allocationId      String            @unique
  fulfilledQuantity Decimal           @default(0) @db.Decimal(12, 2)
  status            FulfillmentStatus @default(ALLOCATED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  allocation        Allocation        @relation(fields: [allocationId], references: [id], onDelete: Cascade)
}

model Backorder {
  id                String          @id @default(cuid())
  orderId           String
  orderItemId       String
  productId         String
  requiredQuantity  Decimal         @db.Decimal(12, 2)
  fulfilledQuantity Decimal         @default(0) @db.Decimal(12, 2)
  remainingQuantity Decimal         @db.Decimal(12, 2)
  status            BackorderStatus @default(BACKORDERED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem         OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderItemId])
  @@index([productId, status])
}

enum ProductType {
  ONE_TIME
  RECURRING
}


enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalRole {
  MANAGER
  FINANCE
}

enum FulfillmentStatus {
  PENDING
  ALLOCATED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum BackorderStatus {
  BACKORDERED
  READY_TO_FULFILL
  FULFILLED
  CANCELLED
}

enum NegotiationStatus {
  OPEN
  COUNTEROFFER_REQUESTED
  COUNTEROFFER_DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACCEPTED
  CLOSED
}
